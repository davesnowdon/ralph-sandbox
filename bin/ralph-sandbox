#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
SANDBOX_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd -P)"
COMPOSE_FILE="${SANDBOX_ROOT}/docker-compose.yml"

usage() {
  cat <<'EOF'
Usage:
  bin/ralph-sandbox [options] [-- ralph_args...]

Options:
  --project-dir PATH        Use an existing project directory. Defaults to the current git root or cwd.
  --tool NAME               Tool to use: claude or codex. Defaults to $RALPH_TOOL or claude.
  --variant NAME            Image variant to run: python, crosstool-ng or cpp. Defaults to python.
  --toolchain-dir PATH      (cpp) Mount a cross toolchain read-only; exposed in-container as $CROSS_TOOLCHAIN_DIR.
  --session-runner PATH     Custom runner script to replace the built-in Ralph loop.
  --claude-config-dir PATH  Claude config directory. Defaults to $CLAUDE_CONFIG_DIR or $HOME/.claude.
  --codex-config-dir PATH   Codex config directory. Defaults to $CODEX_CONFIG_DIR or $HOME/.codex.
  --service NAME            Compose service to run. Defaults to ralph.
  --build                   Pass --build to docker compose run.
  -h, --help                Show this help.

Examples:
  bin/ralph-sandbox
  bin/ralph-sandbox --tool codex
  bin/ralph-sandbox --variant crosstool-ng
  bin/ralph-sandbox --variant cpp --toolchain-dir ~/x-tools/aarch64-unknown-linux-gnu
  bin/ralph-sandbox --session-runner ./my-runner.sh --project-dir /path/to/project
  bin/ralph-sandbox -- 10
EOF
}

require_arg() {
  # Ensure a value-taking flag received a non-empty value; fail with a usage
  # error instead of a `set -u` "unbound variable" crash when it is omitted.
  if [[ -z "${2:-}" ]]; then
    echo "ERROR: Option '$1' requires a value." >&2
    exit 2
  fi
}

abs_existing_dir() {
  local path="$1"
  if [[ ! -d "${path}" ]]; then
    echo "ERROR: Directory does not exist: ${path}" >&2
    exit 2
  fi
  cd -- "${path}" && pwd -P
}

yaml_dquote() {
  # Escape a string for use inside YAML double quotes.
  # Backslash and double-quote are the only characters that need escaping.
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '"%s"' "$s"
}

git_repo_root() {
  local path="$1"
  git -C "${path}" rev-parse --show-toplevel 2>/dev/null || true
}

git_common_dir() {
  local path="$1"
  local common
  common="$(git -C "${path}" rev-parse --git-common-dir 2>/dev/null || true)"
  if [[ -z "${common}" ]]; then
    return 0
  fi
  if [[ "${common}" = /* ]]; then
    printf '%s\n' "${common}"
    return 0
  fi
  cd -- "${path}" && cd -- "${common}" && pwd -P
}

project_dir="${PROJECT_DIR:-}"
ralph_tool="${RALPH_TOOL:-claude}"
variant="python"
toolchain_dir="${CROSS_TOOLCHAIN_DIR:-}"
claude_config_dir="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"
codex_config_dir="${CODEX_CONFIG_DIR:-${HOME}/.codex}"
session_runner=""
service="ralph"
build_flag=0
declare -a ralph_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --project-dir)
      require_arg "$1" "${2:-}"
      project_dir="$2"
      shift 2
      ;;
    --tool)
      require_arg "$1" "${2:-}"
      ralph_tool="$2"
      shift 2
      ;;
    --variant)
      require_arg "$1" "${2:-}"
      variant="$2"
      shift 2
      ;;
    --toolchain-dir)
      require_arg "$1" "${2:-}"
      toolchain_dir="$2"
      shift 2
      ;;
    --session-runner)
      require_arg "$1" "${2:-}"
      session_runner="$2"
      shift 2
      ;;
    --claude-config-dir)
      require_arg "$1" "${2:-}"
      claude_config_dir="$2"
      shift 2
      ;;
    --codex-config-dir)
      require_arg "$1" "${2:-}"
      codex_config_dir="$2"
      shift 2
      ;;
    --service)
      require_arg "$1" "${2:-}"
      service="$2"
      shift 2
      ;;
    --build)
      build_flag=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      ralph_args=("$@")
      break
      ;;
    *)
      ralph_args+=("$1")
      shift
      ;;
  esac
done

# Resolve the compose image + dockerfile for the selected variant. These feed
# docker-compose.yml via ${SANDBOX_IMAGE} / ${SANDBOX_DOCKERFILE}.
case "${variant}" in
  python)
    sandbox_image="ralph-sandbox:python"
    sandbox_dockerfile="dockerfiles/python/Dockerfile"
    ;;
  crosstool-ng)
    sandbox_image="ralph-sandbox:crosstool-ng"
    sandbox_dockerfile="dockerfiles/crosstool-ng/Dockerfile"
    ;;
  cpp)
    sandbox_image="ralph-sandbox:cpp"
    sandbox_dockerfile="dockerfiles/cpp/Dockerfile"
    ;;
  *)
    echo "ERROR: Unsupported variant: ${variant}. Use 'python', 'crosstool-ng' or 'cpp'." >&2
    exit 2
    ;;
esac

if [[ -z "${project_dir}" ]]; then
  project_dir="$(git_repo_root "${PWD}")"
  if [[ -z "${project_dir}" ]]; then
    project_dir="$(pwd -P)"
  fi
fi

project_dir="$(abs_existing_dir "${project_dir}")"

# Resolve session runner to an absolute path (if provided).
if [[ -n "${session_runner}" ]]; then
  if [[ ! -f "${session_runner}" ]]; then
    echo "ERROR: --session-runner path does not exist: ${session_runner}" >&2
    exit 2
  fi
  session_runner="$(cd "$(dirname "${session_runner}")" && pwd -P)/$(basename "${session_runner}")"
fi

# Tool config validation is only needed when using the default runner.
if [[ -z "${session_runner}" ]]; then
  case "${ralph_tool}" in
    claude)
      claude_config_dir="$(abs_existing_dir "${claude_config_dir}")"
      ;;
    codex)
      if ! mkdir -p "${codex_config_dir}"; then
        echo "ERROR: Failed to create codex config directory: ${codex_config_dir}" >&2
        exit 2
      fi
      codex_config_dir="$(abs_existing_dir "${codex_config_dir}")"
      ;;
    *)
      echo "ERROR: Unsupported tool: ${ralph_tool}. Use 'claude' or 'codex'." >&2
      exit 2
      ;;
  esac
fi

common_dir="$(git_common_dir "${project_dir}")"
needs_common_mount=0
if [[ -n "${common_dir}" && "${common_dir}" != "${project_dir}/.git" ]]; then
  common_dir="$(abs_existing_dir "${common_dir}")"
  needs_common_mount=1
fi

# Resolve a cross toolchain dir (cpp variant). Mount it at its own host path
# (source==target) so it works from the path it was built at -- crosstool-ng
# toolchains are not reliably relocatable. Skip the mount if it already lives
# under PROJECT_DIR (already mounted); CROSS_TOOLCHAIN_DIR is exported either way.
toolchain_mount=0
if [[ -n "${toolchain_dir}" ]]; then
  toolchain_dir="$(abs_existing_dir "${toolchain_dir}")"
  if [[ "${toolchain_dir}/" != "${project_dir}/"* ]]; then
    toolchain_mount=1
  fi
fi

tmp_override="$(mktemp "${TMPDIR:-/tmp}/ralph-sandbox.compose.override.XXXXXX.yml")"
cleanup() {
  rm -f -- "${tmp_override}"
}
trap cleanup EXIT

cat >"${tmp_override}" <<EOF
services:
  ${service}:
EOF

# Collect extra volume mounts (tool config, git common dir, session runner).
if [[ ${needs_common_mount} -eq 1 ]] || [[ "${ralph_tool}" == "claude" ]] || [[ "${ralph_tool}" == "codex" ]] || [[ -n "${session_runner}" ]] || [[ ${toolchain_mount} -eq 1 ]]; then
  echo "    volumes:" >>"${tmp_override}"
fi

if [[ "${ralph_tool}" == "claude" ]]; then
  cat >>"${tmp_override}" <<EOF
      - type: bind
        source: $(yaml_dquote "${claude_config_dir}")
        target: /claude_config
EOF
fi

if [[ ${needs_common_mount} -eq 1 ]]; then
  cat >>"${tmp_override}" <<EOF
      - type: bind
        source: $(yaml_dquote "${common_dir}")
        target: $(yaml_dquote "${common_dir}")
EOF
fi

if [[ "${ralph_tool}" == "codex" ]]; then
  cat >>"${tmp_override}" <<EOF
      - type: bind
        source: $(yaml_dquote "${codex_config_dir}")
        target: /codex_config
EOF
fi

if [[ -n "${session_runner}" ]]; then
  cat >>"${tmp_override}" <<EOF
      - type: bind
        source: $(yaml_dquote "${session_runner}")
        target: /run/ralph/session-runner.sh
        read_only: true
EOF
fi

if [[ ${toolchain_mount} -eq 1 ]]; then
  cat >>"${tmp_override}" <<EOF
      - type: bind
        source: $(yaml_dquote "${toolchain_dir}")
        target: $(yaml_dquote "${toolchain_dir}")
        read_only: true
EOF
fi

declare -a compose_cmd=(
  docker compose
  --project-directory "${SANDBOX_ROOT}"
  -f "${COMPOSE_FILE}"
  -f "${tmp_override}"
  run
  --rm
)

if [[ ${build_flag} -eq 1 ]]; then
  compose_cmd+=(--build)
fi

compose_cmd+=("${service}")

session_runner_env=""
if [[ -n "${session_runner}" ]]; then
  session_runner_env="/run/ralph/session-runner.sh"
fi

declare -a config_env=()
case "${ralph_tool}" in
  claude)
    config_env+=(CLAUDE_CONFIG_DIR="${claude_config_dir}")
    ;;
  codex)
    config_env+=(CODEX_CONFIG_DIR="${codex_config_dir}")
    ;;
esac

env \
  PROJECT_DIR="${project_dir}" \
  RALPH_TOOL="${ralph_tool}" \
  SESSION_RUNNER="${session_runner_env}" \
  SANDBOX_IMAGE="${sandbox_image}" \
  SANDBOX_DOCKERFILE="${sandbox_dockerfile}" \
  CROSS_TOOLCHAIN_DIR="${toolchain_dir}" \
  "${config_env[@]}" \
  "${compose_cmd[@]}" \
  "${ralph_args[@]}"
